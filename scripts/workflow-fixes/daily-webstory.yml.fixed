name: Web Story Auto-Publish

# Anti "green-but-empty" guards (2026-08-24), same policy as daily-blog.yml:
#   1. "Verify AI keys" fails fast (RED) when no AI key is configured and
#      lists exactly which keys are missing (names only, never values).
#   2. "Generate today's web story" has NO continue-on-error — a failed
#      generation makes the job RED. A green run means content was created.
#   3. "Commit and push new web story" fails (RED) when generation succeeded
#      but produced zero content changes, so a silent no-op can never look
#      green. (SKIP_AUTO_PUBLISH=1 makes the generator leave the commit/push
#      to this step, so publish always goes through the guarded path here.)

on:
  schedule:
    - cron: '30 15 * * 1,3,5'
  workflow_dispatch:

permissions:
  contents: write

concurrency:
  group: daily-webstory
  cancel-in-progress: false

jobs:
  generate-webstory:
    runs-on: ubuntu-latest
    timeout-minutes: 20
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 1

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: '22'

      - name: Install sharp
        run: npm install --no-save sharp

      - name: Verify AI keys
        id: keys
        env:
          GROQ_API_KEY: ${{ secrets.GROQ_API_KEY }}
          GEMINI_API_KEY: ${{ secrets.GEMINI_API_KEY }}
          DEEPSEEK_API_KEY: ${{ secrets.DEEPSEEK_API_KEY }}
        run: |
          PRESENT=0
          MISSING=""
          for k in GROQ_API_KEY GEMINI_API_KEY DEEPSEEK_API_KEY; do
            if [ -n "$(printenv "$k" || true)" ]; then
              echo "OK $k: configured"
              PRESENT=$((PRESENT + 1))
            else
              echo "MISSING $k"
              MISSING="${MISSING}${MISSING:+ }$k"
            fi
          done
          echo "present=${PRESENT}" >> "$GITHUB_OUTPUT"
          echo "missing=${MISSING}" >> "$GITHUB_OUTPUT"
          if [ -n "$MISSING" ]; then
            echo "::warning title=AI key status::Missing: ${MISSING}. Generation will use the remaining configured key(s)."
          fi
          if [ "$PRESENT" -eq 0 ]; then
            echo "::error title=No AI keys configured::None of GROQ_API_KEY / GEMINI_API_KEY / DEEPSEEK_API_KEY is set. Add at least one as a repo secret (Settings -> Secrets and variables -> Actions) and re-run."
            exit 1
          fi

      - name: Generate today's web story
        id: gen
        env:
          GROQ_API_KEY: ${{ secrets.GROQ_API_KEY }}
          GEMINI_API_KEY: ${{ secrets.GEMINI_API_KEY }}
          DEEPSEEK_API_KEY: ${{ secrets.DEEPSEEK_API_KEY }}
          INDEXNOW_KEY: ${{ secrets.INDEXNOW_KEY }}
          WORKFLOW_PAT: ${{ secrets.WORKFLOW_PAT }}
          # Commit/push is owned by the guarded workflow step below.
          SKIP_AUTO_PUBLISH: '1'
        run: node scripts/generate-webstory.mjs

      - name: Commit and push new web story
        if: ${{ steps.gen.outcome == 'success' }}
        run: |
          git config user.name "AIToolsNova Bot"
          git config user.email "bot@aitoolsnova.com"
          git add web-stories/ web-stories.html sitemap.xml blog/ blogs.html scripts/topic-history.json || true
          if git diff --staged --quiet; then
            # Safety net: if a future change re-enables in-script publishing,
            # accept "nothing staged because the generator already pushed".
            if [ "$(git rev-parse HEAD)" != "$GITHUB_SHA" ] && git ls-remote origin "refs/heads/main" | grep -q "$(git rev-parse HEAD)"; then
              echo "Publish verified: generator already committed and pushed this run's content ($(git rev-parse --short HEAD))."
              exit 0
            fi
            echo "::error title=Nothing published::Web story generator exited 0 but produced no content changes. Failing the job so a silent no-op can never look green."
            exit 1
          fi
          git commit -m "chore(webstory): auto-publish"
          git push

      - name: Ping search engines
        continue-on-error: true
        run: |
          curl -s "https://www.google.com/ping?sitemap=https://aitoolsnova.com/sitemap.xml" || true
          curl -s "https://www.bing.com/ping?sitemap=https://aitoolsnova.com/sitemap.xml" || true
