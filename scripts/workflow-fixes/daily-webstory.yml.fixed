name: Web Story Auto-Publish (daily)

# ─────────────────────────────────────────────────────────────────────────────
# Same anti-"green-but-empty" policy as daily-blog.yml, plus the fix for the
# specific reason this job was RED every day since it existed:
#
#   The old generate step committed .github/workflows/*.yml (a self-heal copy),
#   failed to push it (GitHub refuses workflow writes from a job token), and
#   `git reset --soft HEAD~1` left those workflow files STAGED in the index. The
#   next step committed them again -> push refused -> job red -> and the story
#   that HAD been generated was never published either.
#
# Now: `git reset -q` before staging, workflow paths whitelisted out of every
# content commit, the generator only touches .github/workflows when a
# WORKFLOW_PAT secret exists, and the last step verifies origin/main.
#
# A story is derived from the newest article, so this job also publishes the
# blog when the blog day is missing (AUTO_BLOG_FALLBACK=1, the default).
# ─────────────────────────────────────────────────────────────────────────────

on:
  schedule:
    - cron: '45 6,16 * * *'      # 06:45 + 16:45 UTC, away from the :00 queue
  workflow_dispatch:
    inputs:
      backfill:
        description: 'How many missing days to publish (0 = only today)'
        required: false
        default: '2'
      date:
        description: 'Publish for one specific date (YYYY-MM-DD, optional)'
        required: false
        default: ''
      dry_run:
        description: 'Generate but do not commit/push'
        type: boolean
        required: false
        default: false

permissions:
  contents: write

concurrency:
  group: auto-publish-webstory
  cancel-in-progress: false

jobs:
  publish:
    runs-on: ubuntu-latest
    timeout-minutes: 25
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 1

      - uses: actions/setup-node@v4
        with:
          node-version: '22'

      - name: Install sharp (story image upscaling; optional)
        run: npm install --no-save sharp || echo "::warning title=sharp install failed::story images stay at native size"

      - name: Generate and publish the story
        env:
          GROQ_API_KEY: ${{ secrets.GROQ_API_KEY }}
          GEMINI_API_KEY: ${{ secrets.GEMINI_API_KEY }}
          DEEPSEEK_API_KEY: ${{ secrets.DEEPSEEK_API_KEY }}
          INDEXNOW_KEY: ${{ secrets.INDEXNOW_KEY }}
          WORKFLOW_PAT: ${{ secrets.WORKFLOW_PAT }}
          BACKFILL_MAX: ${{ github.event.inputs.backfill || '2' }}
          PUBLISH_DATE: ${{ github.event.inputs.date }}
          DRY_RUN: ${{ github.event.inputs.dry_run == 'true' && '1' || '0' }}
          SKIP_AUTO_PUBLISH: '1'
        run: node scripts/generate-webstory.mjs --backfill="${BACKFILL_MAX:-2}" ${PUBLISH_DATE:+--date="$PUBLISH_DATE"}

      - name: Commit and push (index-safe, workflow paths excluded)
        if: ${{ github.event.inputs.dry_run != 'true' }}
        run: |
          set -euo pipefail
          git config user.name  "AIToolsNova Bot"
          git config user.email "bot@aitoolsnova.com"
          git reset -q
          git add -A -- web-stories web-stories.html blog blogs.html sitemap.xml \
                        scripts/publish-log.json scripts/topic-history.json publish-status.json 2>/dev/null || true
          git reset -q -- .github/workflows 2>/dev/null || true
          if git diff --staged --quiet; then
            echo "Nothing left to commit - the generator already pushed, or there was nothing to publish."
            exit 0
          fi
          git commit -qm "content(webstory): auto-publish $(date -u +%Y-%m-%d)"
          for i in 1 2 3; do
            if git push origin HEAD:refs/heads/main; then echo "Pushed."; exit 0; fi
            echo "push attempt $i failed - rebasing onto origin/main..."
            git fetch --depth=50 origin main && git rebase --autostash origin/main || git rebase --abort || true
            sleep $((i*10))
          done
          echo "::error title=Story push failed::3 push attempts failed. Check Settings -> Actions -> Workflow permissions = Read and write."
          exit 1

      - name: Verify the story is really on main
        if: ${{ github.event.inputs.dry_run != 'true' }}
        run: node scripts/verify-publish.mjs --kind=webstory --max-age-days=3

      - name: Ping search engines
        continue-on-error: true
        run: |
          curl -s --max-time 20 "https://www.google.com/ping?sitemap=https://aitoolsnova.com/sitemap.xml" || true
          curl -s --max-time 20 "https://indexnow.org/ping?site=aitoolsnova.com" || true

      - name: Health snapshot (report only)
        continue-on-error: true
        run: node scripts/site-health.mjs --offline --ci --max-age-days=4
