name: Blog Auto-Publish (daily)

# ─────────────────────────────────────────────────────────────────────────────
# Why this file looks the way it does (every rule below maps to a real outage):
#
# 1. NO `continue-on-error` on the generate step. It is what made 5 consecutive
#    days of failed runs look GREEN: the generator exited 1 in 0 seconds (no AI
#    key visible), the step was allowed to fail, the commit step saw "no
#    changes" and exited 0. A green tick now always means content landed,
#    because the last step verifies origin/main.
# 2. Two runs per day, both IDEMPOTENT (the generator skips a day that already
#    has a post). GitHub delays `cron: '0 14 * * *'` jobs by hours behind the
#    :00 pile-up - off-minute + a second attempt removes the "missed day".
# 3. `--backfill=2` means a failed/skipped day is caught up automatically
#    instead of being lost forever.
# 4. Do NOT add a `secrets:` key to `permissions:` - it is not a valid scope and
#    silently invalidates the whole workflow (0s red runs, no logs).
# 5. The commit step resets the index first, so no stale staged file (e.g. a
#    workflow YAML touched by a self-heal) can ride into the push and get the
#    push refused by GitHub's "workflows permission" rule.
# ─────────────────────────────────────────────────────────────────────────────

on:
  schedule:
    - cron: '20 5,14 * * *'      # 05:20 + 14:20 UTC  (10:50 / 19:50 IST)
  workflow_dispatch:
    inputs:
      backfill:
        description: 'How many missing days to publish (0 = only today)'
        required: false
        default: '2'
      date:
        description: 'Publish for one specific date (YYYY-MM-DD, optional)'
        required: false
        default: ''
      dry_run:
        description: 'Generate but do not commit/push'
        type: boolean
        required: false
        default: false

permissions:
  contents: write

concurrency:
  group: auto-publish-blog
  cancel-in-progress: false

jobs:
  publish:
    runs-on: ubuntu-latest
    timeout-minutes: 25
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 1

      - uses: actions/setup-node@v4
        with:
          node-version: '22'

      # Advisory only: the generator can still publish through the site's own
      # /api/gemini proxy, so a missing key must not be a hard stop. It DOES
      # print exactly which secret to add, in the run log.
      - name: Check AI keys
        env:
          GROQ_API_KEY: ${{ secrets.GROQ_API_KEY }}
          GEMINI_API_KEY: ${{ secrets.GEMINI_API_KEY }}
          DEEPSEEK_API_KEY: ${{ secrets.DEEPSEEK_API_KEY }}
        run: |
          node -e 'const fs=require("fs");const k=["GROQ_API_KEY","GEMINI_API_KEY","DEEPSEEK_API_KEY"].filter(n=>process.env[n]);
          console.log(k.length?"Keys configured: "+k.join(", "):"::warning title=No AI key secret::Add GROQ_API_KEY (Settings -> Secrets and variables -> Actions). The site API fallback will be used instead.");'

      - name: Install sharp (hero image upscaling; optional)
        run: npm install --no-save sharp || echo "::warning title=sharp install failed::hero images will stay at native size"

      - name: Generate and publish the blog post(s)
        env:
          GROQ_API_KEY: ${{ secrets.GROQ_API_KEY }}
          GEMINI_API_KEY: ${{ secrets.GEMINI_API_KEY }}
          DEEPSEEK_API_KEY: ${{ secrets.DEEPSEEK_API_KEY }}
          INDEXNOW_KEY: ${{ secrets.INDEXNOW_KEY }}
          BACKFILL_MAX: ${{ github.event.inputs.backfill || '2' }}
          PUBLISH_DATE: ${{ github.event.inputs.date }}
          DRY_RUN: ${{ github.event.inputs.dry_run == 'true' && '1' || '0' }}
          # The commit step below owns the push, so the generator must not
          # double-push; it still writes files + ledger + publish-status.json.
          SKIP_AUTO_PUBLISH: '1'
        run: node scripts/generate-blog.mjs --backfill="${BACKFILL_MAX:-2}" ${PUBLISH_DATE:+--date="$PUBLISH_DATE"}

      - name: Commit and push (index-safe)
        if: ${{ github.event.inputs.dry_run != 'true' }}
        run: |
          set -euo pipefail
          git config user.name  "AIToolsNova Bot"
          git config user.email "bot@aitoolsnova.com"
          git reset -q                                   # never inherit a stale index
          git add -A -- blog blogs.html sitemap.xml scripts/publish-log.json scripts/topic-history.json publish-status.json 2>/dev/null || true
          git reset -q -- .github/workflows 2>/dev/null || true
          if git diff --staged --quiet; then
            echo "Nothing left to commit - the generator already pushed, or there was nothing to publish."
            exit 0
          fi
          git commit -qm "content(blog): auto-publish $(date -u +%Y-%m-%d)"
          for i in 1 2 3; do
            if git push origin HEAD:refs/heads/main; then echo "Pushed."; exit 0; fi
            echo "push attempt $i failed - rebasing onto origin/main..."
            git fetch --depth=50 origin main && git rebase --autostash origin/main || git rebase --abort || true
            sleep $((i*10))
          done
          echo "::error title=Blog push failed::3 push attempts failed. Check Settings -> Actions -> Workflow permissions = Read and write."
          exit 1

      - name: Verify the post is really on main
        if: ${{ github.event.inputs.dry_run != 'true' }}
        run: node scripts/verify-publish.mjs --kind=blog --max-age-days=3

      - name: Ping search engines
        continue-on-error: true
        run: |
          curl -s --max-time 20 "https://www.google.com/ping?sitemap=https://aitoolsnova.com/sitemap.xml" || true
          curl -s --max-time 20 "https://indexnow.org/ping?site=aitoolsnova.com" || true

      - name: Health snapshot (report only)
        continue-on-error: true
        run: node scripts/site-health.mjs --offline --ci --max-age-days=4
