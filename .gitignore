# ============ AIToolsNova - .gitignore ============
# Cloudflare Pages friendly: ONLY exclude local/build artifacts.
# Everything else (blog/, tools/, images/, functions/) must be committed.

# ----- Emergent Preview Only (not needed on Cloudflare) -----
backend/
frontend/
memory/
test_reports/

# ----- Node / Package Managers -----
node_modules/
jspm_packages/
.npm
.pnpm-store
.yarn-integrity

# ----- Logs -----
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ----- Environment / Secrets -----
.env
.env.local
.env.*.local
*.env
credentials.json
*.pem
*.key
.credentials

# ----- Build Output -----
dist/
build/
out/
.cache/
.parcel-cache/
.next/

# ----- IDE / Editor -----
.vscode/
.idea/
*.swp
*.swo
.tern-port

# ----- System -----
.DS_Store
Thumbs.db

# ----- Test / Coverage -----
coverage/
.nyc_output/
*.lcov

# ----- Emergent Internal -----
.emergent/
.env.*
