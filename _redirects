/privacy                               /privacy-policy.html            301
/sitemap-generator                     /tools/sitemap-generator.html   301
/sitemap-generator.html                /tools/sitemap-generator.html   301

# Old calculator/converter URLs that no longer exist -> tools hub (kills hard 404)
/unit-converter.html                   /tools.html                     301
/unit-converter                        /tools.html                     301
/fuel-cost-calculator.html             /tools.html                     301
/fuel-cost-calculator                  /tools.html                     301
