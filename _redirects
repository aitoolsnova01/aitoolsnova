# Redirects for AIToolsNova - Cloudflare Pages
# Canonicalize URL variants to prevent Google Search Console
# "Duplicate without user-selected canonical" errors.

# Force single canonical entry-point

# Trailing-slash normalization for known folders
# ============================================
# CANONICAL HOST - www -> non-www (GSC duplicate content fix)
# Both www and apex were serving 200, splitting ranking signals.
# ============================================
# NOTE: Pages _redirects cannot match on hostname. The www -> apex 301 must be
# created as a Cloudflare **Redirect Rule** in the dashboard (see CLOUDFLARE-GSC-ADSENSE.md).

/tools/                                /tools                           301
/blogs/                                /blogs                           301
/blog/                                 /blogs                           301

# Common typo redirects (avoid soft-404s)
/tool                                  /tools                           301
/blog-list                             /blogs                           301
/contact-us                            /contact                         301
/about-us                              /about                           301

# ============================================
# Legacy / old-WordPress URLs (from GSC "Not found 404" report - Aug 2026)
# ============================================

# Legacy policy + tool that moved
/privacy.html                          /privacy-policy                  301
/privacy                               /privacy-policy                  301
/sitemap-generator                     /tools/sitemap-generator         301
/sitemap-generator.html                /tools/sitemap-generator         301

# Old calculator/converter URLs that no longer exist -> tools hub (kills hard 404)
/unit-converter.html                   /tools                           301
/unit-converter                        /tools                           301
/fuel-cost-calculator.html             /tools                           301
/fuel-cost-calculator                  /tools                           301
/loan-emi-calculator.html              /tools                           301
/loan-emi-calculator                   /tools                           301
/body-fat-calculator.html              /tools                           301
/body-fat-calculator                   /tools                           301
/calculators/*                         /tools                           301

# Old WordPress artifacts -> home (clears GSC 404s for the previous WP site)
/hello-world/                          /                               301
/hello-world                           /                               301
/wp-content/*                          /                               301
/wp-includes/*                         /                               301
/wp-admin/*                            /                               301
/feed/*                                /                               301
/search/*                              /                               301
# REMOVED: /?feed=* -> / matched the bare "/" path and caused a homepage redirect loop

# ============================================
# Extensionless canonical — force .html → clean (CF also does this, belt+suspenders)
# ============================================
/index.html                            /                                 301
/tools.html                            /tools                            301
/blogs.html                            /blogs                            301
/about.html                            /about                            301
/contact.html                          /contact                          301
/privacy-policy.html                   /privacy-policy                   301
/terms-and-conditions.html             /terms-and-conditions             301
/disclaimer.html                       /disclaimer                       301
/cookie-policy.html                    /cookie-policy                    301
/web-stories.html                      /web-stories                      301
/free-chatgpt-prompts.html             /free-chatgpt-prompts             301
/monetize-tools.html                   /monetize-tools                   301

# Blog / tools / stories / compare .html → extensionless
/blog/*.html                           /blog/:splat                      301
/tools/*.html                          /tools/:splat                     301
/web-stories/*.html                    /web-stories/:splat               301
/compare/*.html                        /compare/:splat                   301

# Trailing slash cleanup for content hubs
/about/                                /about                            301
/contact/                              /contact                          301
/web-stories/                          /web-stories                      301
/compare/                              /compare                          301
