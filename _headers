/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# HTML pages (incl. extensionless /tools, /blogs). Edge TTL is driven by the
# Cloudflare Cache Rule; this controls the browser side.
/*.html
  Cache-Control: public, max-age=60, s-maxage=300, stale-while-revalidate=600
/
  Cache-Control: public, max-age=60, s-maxage=300, stale-while-revalidate=600

# ---- CSS/JS are edited in-place (no content-hash in the filename). ----
# A 1-year `immutable` cache hid consent.js / enhancements.js updates after
# deploy — browsers and the edge kept serving the old file. Short TTL +
# must-revalidate so the next page load picks up a new deploy.
/*.css
  Cache-Control: public, max-age=120, s-maxage=120, must-revalidate
/*.js
  Cache-Control: public, max-age=120, s-maxage=120, must-revalidate
/images/*
  Cache-Control: public, max-age=31536000, immutable
/web-stories/img/*
  Cache-Control: public, max-age=31536000, immutable
/*.webp
  Cache-Control: public, max-age=31536000, immutable
/*.png
  Cache-Control: public, max-age=31536000, immutable
/*.jpg
  Cache-Control: public, max-age=31536000, immutable
/*.svg
  Cache-Control: public, max-age=31536000, immutable
/*.ico
  Cache-Control: public, max-age=604800

# ---- Crawler files: short cache so updates propagate fast ----
/ads.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=600, s-maxage=600
/robots.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=600, s-maxage=600
/sitemap.xml
  Content-Type: application/xml; charset=utf-8
  Cache-Control: public, max-age=600, s-maxage=1800

# ---- Background Remover needs cross-origin isolation for multithreaded WASM ----
# 'credentialless' keeps third-party scripts (AdSense, GA) working, unlike
# 'require-corp' which would break them.
/tools/background-remover*
  Cross-Origin-Embedder-Policy: credentialless
  Cross-Origin-Opener-Policy: same-origin

/blog/img/*
  Cache-Control: public, max-age=31536000, immutable
